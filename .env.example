# Canonical site URL used for Open Graph images
NEXT_PUBLIC_SITE_URL=https://apexarsenal.us
# Destinations for calls to action. Leave blank to route the link to the help desk.
NEXT_PUBLIC_SOLICITATION_URL=
NEXT_PUBLIC_RUBRIC_URL=
NEXT_PUBLIC_SUBMIT_URL=
NEXT_PUBLIC_MANAGE_SUBMISSION_URL=
NEXT_PUBLIC_GOVERNMENT_MARKETPLACE_URL=
NEXT_PUBLIC_OFFICE_HOURS_URL=
# Explainer videos (embed URLs). Leave blank to show a "coming soon" poster.
NEXT_PUBLIC_VIDEO_MARKETPLACE_URL=
NEXT_PUBLIC_VIDEO_SUBMISSION_URL=
NEXT_PUBLIC_VIDEO_GOVERNMENT_URL=
# Set to true on opening day to enable submit / explore buttons (default: grayed out with opening note)
NEXT_PUBLIC_SUBMISSIONS_OPEN=
# Destination for the header "Create/Login Account" button once registration opens
NEXT_PUBLIC_ACCOUNT_URL=
